# Configurazione FACOLTATIVA di Orbit. Orbit usa Claude Code con il login del tuo abbonamento:
# non serve nessuna chiave API e non va messa nessuna chiave in questo file.
#
# Se vuoi cambiare qualcosa, copia questo file in:
#   %LOCALAPPDATA%\Orbit\.env
# (fuori dal vault Obsidian). Le variabili d'ambiente di Windows hanno la precedenza.
#
# NON impostare mai ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, ANTHROPIC_BASE_URL, CLAUDE_CODE_USE_BEDROCK,
# CLAUDE_CODE_USE_VERTEX o CLAUDE_CODE_USE_FOUNDRY: farebbero usare l'API a pagamento. Orbit le ignora e le
# toglie al processo di Claude Code, ma e meglio che non esistano nemmeno nel sistema.

# --- Modelli ---
# Vuoti = alias di Claude Code (haiku, sonnet, opus). Per fissarli usa un nome che funziona nel tuo `claude --model`.
ORBIT_MODEL_HAIKU=
ORBIT_MODEL_SONNET=
ORBIT_MODEL_OPUS=

# --- Consumo dell'abbonamento ---
# Verifica AI: auto = solo dove serve (complessita alta, rischio non basso, risposte dalle note);
#              sempre = su ogni risposta (consuma di piu).
ORBIT_AI_VERIFY=auto
ORBIT_MAX_CALLS_PER_HOUR=30           # chiamate a Claude per ora: oltre, Orbit si ferma
ORBIT_MAX_CALLS_PER_DAY=150           # chiamate a Claude per giorno
ORBIT_DAILY_TOKEN_LIMIT=0             # 0 = nessun limite
ORBIT_MAX_INPUT_TOKENS=12000          # contesto massimo per chiamata
ORBIT_MAX_OUTPUT_TOKENS=2048          # risposta massima per chiamata
ORBIT_BUDGET_TOKENS_REQUEST=60000     # token totali (ingresso + uscita) per richiesta, verifiche incluse
ORBIT_BUDGET_TOKENS_ATTEMPT=24000     # token per singolo tentativo
ORBIT_MAX_ESCALATIONS=2               # passaggi a un modello superiore al massimo
ORBIT_MAX_ATTEMPTS=4                  # tentativi massimi di produzione per richiesta
ORBIT_TIMEOUT_MS=90000                # timeout per singola chiamata (l'avvio di Claude Code richiede qualche secondo)
ORBIT_REQUEST_TIMEOUT_MS=240000       # timeout totale per richiesta
ORBIT_API_RETRIES=1                   # nuovi tentativi su sovraccarico (mai sui limiti dell'abbonamento)
ORBIT_RATE_LIMIT_PER_MIN=20           # richieste di chat al minuto accettate dal server locale

# --- Server e dati ---
ORBIT_PORT=4778
# Browser aperto all'avvio: auto = Chrome se installato (serve per dettatura e voce italiana), altrimenti il predefinito;
# default = sempre il predefinito di Windows; nessuno = non aprire nulla; oppure il percorso di un .exe. Mai Edge.
ORBIT_BROWSER=auto
# ORBIT_CLAUDE=claude                 # comando di Claude Code, se non e nel PATH
# ORBIT_DATA_DIR=                     # database e dati tecnici (predefinito %LOCALAPPDATA%\Orbit)
# ORBIT_VAULT_PATH=                   # vault Obsidian da leggere. Se manca: la cartella che contiene .orbit-hud (se ha .obsidian), poi Documents\Orbit
# ORBIT_UTENTE=                       # nome con cui Orbit si rivolge a te nei prompt e nei saluti (predefinito: Utente)
# ORBIT_UTENTE_PROFILO=               # descrizione breve nel prompt di sistema, es. "studente di Ingegneria" (predefinita: nessuna)
# ORBIT_PAROLE_CORSO=                 # sigle dei tuoi corsi, separate da virgola, che fanno cercare nel vault (es. fis, mec)
# ORBIT_LOCAL_ENV=                    # file di profilo locale privato (predefinito privato/orbit.env nel repository, escluso da Git)
ORBIT_LOG_LEVEL=info                  # error, warn, info, debug

# --- Riconoscimento vocale locale (Whisper, vedi .orbit-hud/docs/WHISPER-STT.md) ---
# Installazione una tantum: node orbit/tools/installa-stt.js (scarica whisper.cpp, Whisper Small e il modello Vosk per "Orbit")
# ORBIT_STT_MOTORE=whisper            # whisper (locale, offline) oppure browser (vecchio riconoscimento di Chrome, invia l'audio a Google)
# ORBIT_STT_MODELLO=small             # small (predefinito) oppure base, se Small risulta troppo lento: solo se decidi tu
# ORBIT_STT_LINGUA=it                 # lingua della trascrizione (it, en... o auto)
# ORBIT_STT_THREADS=6                 # thread di whisper.cpp
# ORBIT_STT_CONTESTO=3                # finestra audio di Whisper in multipli della durata del parlato (0 = 30 s pieni)
# ORBIT_STT_PAROLA=orbit              # parola di attivazione (separate da virgola per varianti)
# ORBIT_STT_VARIANTI=                 # grafie che Vosk puo dare a «Orbit» (es. orbita): contano solo come prima parola della frase; da aggiungere dopo averle misurate
# ORBIT_STT_DIAGNOSTICA=0             # 1 = la console mostra il testo grezzo di ogni trascrizione con durata e affidabilita (dati personali: solo per le prove)
# ORBIT_STT_DIAGNOSTICA_DIR=          # con la diagnostica accesa salva qui gli ultimi 10 comandi come cmd-<timestamp>.wav: sono registrazioni della tua voce, da cancellare a fine prova
# ORBIT_STT_PROMPT=                   # vocabolario di partenza per Whisper (max 200 caratteri); spento di default: con «Orbit, assistente personale. Italiano.» su un comando reale di 19 s con tre frasi Whisper si e fermato alla prima. Riattivalo solo dopo averlo provato su piu registrazioni reali

# --- Voce (docs/ELEVENLABS.md) ---
# Motore predefinito: ElevenLabs (cloud, a pagamento) con ripiego automatico su Piper locale se manca la chiave, i crediti finiscono o la rete non risponde.
# ELEVENLABS_API_KEY=                 # la chiave la metti SOLO tu, in %LOCALAPPDATA%\Orbit\.env o privato/orbit.env: mai in Git, nel vault o in chat
# ORBIT_TTS_VOCE_ID=                  # id della voce (elenco: node orbit/tools/prova-elevenlabs.js --voci). Senza voce Orbit usa Piper
# ORBIT_TTS_MODELLO=eleven_v3   # alternative: eleven_multilingual_v2 (stabile), eleven_flash_v2_5 (piu veloce)
# ORBIT_TTS_MAX_CARATTERI_MESE=0      # tetto di caratteri al mese; 0 = il limite del piano. Oltre il tetto si usa Piper
# ORBIT_TTS_MOTORE=elevenlabs         # piper = solo voce locale
